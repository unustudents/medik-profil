---
import { Image } from "astro:assets";

const PANORAMA_IMAGE =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuCC1KUdrr8n3U5L7Y2Wje2AUjLI7VSwsQSARdfBZOzMdhc6O0n30fzfc0iLbibHag57HPXmgnzay2Y7B8CEMLOQ25LlcOcgrgkASqXOd-uL6kxqYQls4sTjn8UcFsYnSt4ljwxXjnILNPI6IXsjrj9akek86wToyyKnLoD5PalVI2Hn2wVyAE0oVBdU4L19kNzgMa8yhMa86tA_IlahGr1jbs61BcvGhGrqvO07YJKaJQFPcsPNZRyHiJpSmw9jrwYZZ-F_jWK0ApE";
---

<section class="overflow-hidden bg-white py-20 dark:bg-slate-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div>
        <span class="text-sm font-bold tracking-widest text-slate-400 uppercase"
          >Ketersediaan Kamar</span
        >
        <h2 class="text-primary mt-4 mb-8 text-5xl font-extrabold">
          Ruang Cempaka
        </h2>
        <div class="mb-10 flex flex-wrap gap-2">
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Kamar Mandi</span
          >
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Televisi</span
          >
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Set Sofa</span
          >
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Room Alarm</span
          >
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Air Conditioner</span
          >
          <span
            class="bg-primary/10 text-primary rounded-full px-4 py-2 text-xs font-bold"
            >Toilet</span
          >
        </div>
      </div>
      <div class="relative">
        <div class="grid grid-cols-12 gap-4">
          {/* Frame 1: Left View */}
          <div class="group relative col-span-6 h-[400px]">
            <div
              class="relative h-full overflow-hidden rounded-2xl border-4 border-white shadow-2xl transition-transform duration-500 hover:scale-105 dark:border-slate-800"
            >
              <Image
                src={PANORAMA_IMAGE}
                alt="Hospital Room"
                width={600}
                height={400}
                class="h-full w-full object-cover object-left transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute bottom-4 left-4 z-10">
                <span
                  class="bg-primary flex items-center space-x-2 rounded-lg px-4 py-2 text-xs font-bold text-white shadow-lg"
                >
                  <span class="material-icons-outlined text-sm">stars</span>
                  <span>VIP Room</span>
                </span>
              </div>
            </div>
          </div>

          {/* Frame 2: Center View */}
          <div class="group col-span-3 mt-8 h-[400px]">
            <div
              class="relative h-full overflow-hidden rounded-2xl border-4 border-white shadow-2xl transition-transform duration-500 hover:-translate-y-2 hover:scale-105 dark:border-slate-800"
            >
              <Image
                src={PANORAMA_IMAGE}
                alt="Hospital interior"
                width={600}
                height={400}
                class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
              />
            </div>
          </div>

          {/* Frame 3: Right View */}
          <div class="group relative col-span-3 mt-16 h-[400px]">
            <div
              class="relative h-full overflow-hidden rounded-2xl border-4 border-white shadow-2xl transition-transform duration-500 hover:-translate-y-2 hover:scale-105 dark:border-slate-800"
            >
              <Image
                src={PANORAMA_IMAGE}
                alt="Medical facility"
                width={600}
                height={400}
                class="h-full w-full object-cover object-right transition-transform duration-700 group-hover:scale-110"
              />
              <div
                class="absolute top-4 left-4 z-10 rounded-xl border border-slate-100 bg-white p-3 text-center shadow-lg dark:border-slate-700 dark:bg-slate-800"
              >
                <p class="text-[10px] font-bold text-slate-400">Kapasitas</p>
                <p class="text-primary text-2xl font-black">4</p>
                <p
                  class="text-[10px] font-bold tracking-widest text-slate-400 uppercase"
                >
                  Set
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
