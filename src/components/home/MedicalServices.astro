---
import { Image } from "astro:assets";
import { medicalServices } from "@/data/medicalServices";

const LIMIT = 5;
const featuredServices = medicalServices.slice(0, LIMIT);
---

<section class="py-24 bg-background-light dark:bg-background-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-extrabold text-primary mb-6">
                Layanan Medis
            </h2>
            <p
                class="max-w-2xl mx-auto text-slate-500 dark:text-slate-400 text-sm"
            >
                Rumah Sakit ini mempunyai banyak departemen yang terbagi menjadi
                berbagai poliklinik. Berikut adalah layanan utama kami
            </p>
        </div>

        {
            featuredServices.length === 0 ? (
                <div class="text-center py-16">
                    <span class="material-icons-outlined text-slate-300 dark:text-slate-600 text-6xl mb-4">
                        medical_services
                    </span>
                    <p class="text-slate-500 dark:text-slate-400">
                        Belum ada layanan medis yang tersedia
                    </p>
                </div>
            ) : (
                <div class="embla-medical">
                    <div class="embla__viewport">
                        <div class="embla__container">
                            {featuredServices.map((service) => (
                                <div class="embla__slide">
                                    <div class="group cursor-pointer h-full">
                                        <div class="relative mb-8 mx-auto w-full aspect-video rounded-3xl overflow-hidden">
                                            <Image
                                                src={service.image}
                                                alt={service.title}
                                                width={800}
                                                height={450}
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                                fetchpriority={"low"}
                                            />
                                            <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-12 h-12 rounded-full border-4 border-white dark:border-slate-900 bg-primary flex items-center justify-center">
                                                <span class="material-icons-outlined text-white text-xl">
                                                    {service.icon}
                                                </span>
                                            </div>
                                        </div>
                                        <h3 class="text-lg font-bold text-primary mb-4 text-center">
                                            {service.title}
                                        </h3>
                                        <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed px-6 text-center">
                                            {service.description}
                                        </p>
                                    </div>
                                </div>
                            ))}

                            {/* Kartu "Lihat Semua" di posisi ke-6 */}
                            <div class="embla__slide">
                                <a
                                    href="#"
                                    class="group relative flex flex-col items-center justify-center h-full min-h-[300px] rounded-3xl bg-primary/10 dark:bg-primary/20 hover:bg-primary hover:text-white transition-all duration-300 border-2 border-dashed border-primary/30 text-primary dark:text-primary-light"
                                >
                                    <div class="w-16 h-16 rounded-full bg-white/50 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-sm">
                                        <span class="material-icons-outlined text-3xl">
                                            arrow_forward
                                        </span>
                                    </div>
                                    <h3 class="font-bold text-lg text-center px-4">
                                        Lihat Semua Layanan
                                    </h3>
                                    <p class="text-xs text-center mt-2 opacity-80 group-hover:text-white">
                                        {medicalServices.length - LIMIT}+
                                        Layanan Lainnya
                                    </p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            )
        }
    </div>
</section>

<style>
    .embla {
        position: relative;
    }

    .embla__viewport {
        overflow: hidden;
    }

    .embla__container {
        display: flex;
        touch-action: pan-y pinch-zoom;
        margin-left: -1rem;
    }

    .embla__slide {
        flex: 0 0 100%;
        min-width: 0;
        padding-left: 1rem;
    }

    @media (min-width: 768px) {
        .embla__slide {
            flex: 0 0 50%;
        }
    }

    @media (min-width: 1024px) {
        .embla__slide {
            flex: 0 0 33.333333%;
        }
    }
</style>

<script>
    import { initCarousel } from "../../lib/carousel";

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () =>
            initCarousel(".embla-medical"),
        );
    } else {
        initCarousel(".embla-medical");
    }
</script>
