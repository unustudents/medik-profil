<section class="bg-background-light dark:bg-background-dark py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex flex-col items-center gap-12 lg:flex-row">
      <div class="lg:w-1/2">
        <div class="mb-4 flex items-center space-x-4">
          <div class="h-[1px] flex-1 bg-slate-300 dark:bg-slate-700"></div>
          <span
            class="text-[10px] font-bold tracking-[0.2em] text-slate-400 uppercase"
            >Galeri Dokumentasi</span
          >
          <div class="h-[1px] flex-1 bg-slate-300 dark:bg-slate-700"></div>
        </div>
        <h2
          class="text-primary text-center text-4xl font-extrabold lg:text-right"
        >
          Galeri Foto Dari Pos Galeri
        </h2>
      </div>
      <div class="lg:w-1/2">
        <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
          eiusmod tempor incididunt ut labore et dolore magna aliqua. Quis ipsum
          suspendisse ultrices gravida. Risus commodo viverra maecenas accumsan
          lacus vel facilisis.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="group relative h-64 overflow-hidden rounded-2xl shadow-lg">
        <img
          alt="Dokumentasi kegiatan RSU Afdila - Galeri 6"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
        >
        </div>
        <div class="absolute top-4 right-4">
          <button
            class="bg-primary rounded px-3 py-1 text-[10px] font-bold text-white"
            >Lihat Detail</button
          >
        </div>
        <div class="absolute bottom-4 left-4 flex items-center space-x-2">
          <div class="bg-primary h-4 w-1"></div>
          <span class="text-xs font-bold text-white">Galeri 6</span>
        </div>
      </div>
      <div class="group relative h-64 overflow-hidden rounded-2xl shadow-lg">
        <img
