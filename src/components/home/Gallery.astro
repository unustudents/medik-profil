        </div>
        <div class="absolute bottom-4 left-4 flex items-center space-x-2">
          <div class="bg-primary h-4 w-1"></div>
          <span class="text-xs font-bold text-white">Galeri 5</span>
        </div>
      </div>
      <div class="group relative h-64 overflow-hidden rounded-2xl shadow-lg">
