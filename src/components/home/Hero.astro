---
import { Picture } from "astro:assets";

interface Props {
    images?: string[];
}
const { images } = Astro.props;
---

<section class="embla-hero relative h-[500px] overflow-hidden group">
    <div class="embla__viewport h-full w-full">
        <div class="embla__container h-full">
            {
                images?.map((img, index) => (
                    <div class="embla__slide relative min-w-full h-full">
                        <Picture
                            alt={`Hero Image ${index + 1}`}
                            class="w-full h-full object-cover"
                            src={img}
                            formats={["avif", "webp"]}
                            loading={index === 0 ? "eager" : "lazy"}
                            fetchpriority={index === 0 ? "high" : "auto"}
                            inferSize
                        />
                        <div class="absolute inset-0 hero-gradient" />
                    </div>
                ))
            }
        </div>
    </div>

    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="flex space-x-2 z-10 pointer-events-auto">
            {
                images?.map((_, index) => (
                    <button
                        class={`w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? "bg-white scale-125" : "border-2 border-white bg-transparent"}`}
                        data-hero-indicator
                        data-index={index}
                        aria-label={`Go to slide ${index + 1}`}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .embla__viewport {
        overflow: hidden;
    }
    .embla__container {
        display: flex;
    }
    .embla__slide {
        flex: 0 0 100%;
        min-width: 0;
    }
</style>

<script>
    import { initHeroCarousel } from "../../lib/carousel";

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
             initHeroCarousel(".embla-hero", { delay: 10000 });
        });
    } else {
         initHeroCarousel(".embla-hero", { delay: 10000 });
    }
</script>
