---
import { ADDRESS, CONTACTS, MENU } from "@/consts";
import { Image } from "astro:assets";
import { logo } from "@/assets";

// Tanggal dinamis (server-side)
const now = new Date();
const todayDate = new Intl.DateTimeFormat("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(now);
---

<header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-sm transition-colors duration-300 dark:border-slate-800 dark:bg-slate-900/80 dark:backdrop-blur-sm"
>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex hidden items-center justify-between border-b border-slate-100 py-3 lg:flex dark:border-slate-800"
    >
      <div class="flex items-center space-x-6">
        <div class="flex items-center space-x-2">
          <span class="material-icons-outlined text-primary">location_on</span>
          <div class="text-[10px] leading-tight">
            <p class="font-bold text-slate-400 uppercase">Alamat / Address</p>
            <p class="text-slate-600 dark:text-slate-300">
              {ADDRESS}
            </p>
          </div>
        </div>
        <div
          class="flex items-center space-x-2 border-l border-slate-200 pl-6 dark:border-slate-700"
        >
          <span class="material-icons-outlined text-primary">schedule</span>
          <div class="text-[10px] leading-tight">
            <p class="font-bold text-slate-400 uppercase">
              {todayDate}
            </p>
            <p class="font-bold text-slate-600 dark:text-slate-300">
              08:00 - 22:00 <span
                class="bg-primary rounded px-1 text-[8px] text-white">WIB</span
              >
            </p>
          </div>
        </div>
      </div>
      <div class="flex items-center space-x-2">
        <span class="material-icons-outlined text-primary">phone_in_talk</span>
        <div class="text-[10px] leading-tight">
          <p class="font-bold text-slate-400 uppercase">Darurat / UGD</p>
          <p class="text-primary text-base leading-none font-bold">
            {CONTACTS.igd}
          </p>
        </div>
      </div>
    </div>
    <nav class="flex items-center justify-between py-4">
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-2">
          <!-- <div
						class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center"
					>
						<span class="material-icons-outlined text-white"
							>medical_services</span
						>
					</div>
					<span class="text-xl font-bold text-primary tracking-tight"
						>RSU Afdila</span
					> -->
          <a href="/">
            <Image src={logo} alt="RSU Afdila Logo" class="h-10 w-auto" />
          </a>
        </div>

        <!-- Desktop Menu -->
        <div class="hidden space-x-6 text-sm font-medium lg:flex">
          {
            MENU.map((item) =>
              item.subItems ? (
                <div class="group relative">
                  <button class="hover:text-primary flex items-center gap-1 text-slate-700 transition-colors focus:outline-none dark:text-slate-200">
                    {item.name}
                    <span class="material-icons-outlined text-sm transition-transform group-hover:rotate-180">
                      expand_more
                    </span>
                  </button>
                  <div class="invisible absolute top-full left-0 z-50 w-56 translate-y-2 transform pt-4 opacity-0 transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                    <div class="overflow-hidden rounded-xl border border-slate-100 bg-white py-2 shadow-xl dark:border-slate-800 dark:bg-slate-900">
                      {item.subItems.map((subItem) => (
                        <a
                          href={subItem.href}
                          class="hover:text-primary dark:hover:text-primary block px-4 py-2 text-slate-600 transition-colors hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-800"
                        >
                          {subItem.name}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  class="hover:text-primary text-slate-700 transition-colors dark:text-slate-200"
                  href={item.href}
                >
                  {item.name}
                </a>
              )
            )
          }
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <!-- <div class="relative hidden sm:block">
					<input
						class="pl-4 pr-10 py-2 rounded-full border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20"
						placeholder="Search Doctor..."
						type="text"
					/>
					<span
						class="material-icons-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"
						>search</span
					>
				</div> -->
        <button
          id="mobile-menu-btn"
          class="bg-primary hover:bg-primary/90 rounded-lg p-2 text-white transition-colors lg:hidden"
          aria-label="Toggle menu navigasi"
        >
          <span class="material-icons-outlined">menu</span>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="absolute top-full right-0 left-0 z-40 max-h-[calc(100vh-100px)] origin-top scale-y-0 transform overflow-y-auto border-t border-slate-200 bg-white shadow-lg transition-transform duration-300 ease-in-out lg:hidden dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="space-y-2 px-4 py-4">
        {
          MENU.map((item) =>
            item.subItems ? (
              <div class="space-y-1">
                <button class="mobile-dropdown-btn hover:bg-primary/10 hover:text-primary flex w-full items-center justify-between rounded-lg px-4 py-2 font-medium text-slate-700 transition-colors dark:text-slate-200">
                  <span>{item.name}</span>
                  <span class="material-icons-outlined mobile-dropdown-icon text-sm transition-transform duration-300">
                    expand_more
                  </span>
                </button>
                <div class="mobile-dropdown-content mx-2 hidden space-y-1 rounded-lg bg-slate-50 py-2 pl-4 dark:bg-slate-800/50">
                  {item.subItems.map((subItem) => (
                    <a
                      href={subItem.href}
                      class="hover:text-primary block px-4 py-2 text-sm text-slate-600 transition-colors dark:text-slate-400"
                    >
                      {subItem.name}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="hover:bg-primary/10 hover:text-primary block rounded-lg px-4 py-2 font-medium text-slate-700 transition-colors dark:text-slate-200"
              >
                {item.name}
              </a>
            )
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  // Constants
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileDropdownBtns = document.querySelectorAll(".mobile-dropdown-btn");

  // Toggle Mobile Menu
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener("click", () => {
      const isExpanded = mobileMenu.classList.contains("scale-y-100");
      if (isExpanded) {
        mobileMenu.classList.remove("scale-y-100");
        mobileMenu.classList.add("scale-y-0");
      } else {
        mobileMenu.classList.remove("scale-y-0");
        mobileMenu.classList.add("scale-y-100");
      }
    });
  }

  // Toggle Mobile Dropdown (Accordion)
  if (mobileDropdownBtns) {
    mobileDropdownBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const content = btn.nextElementSibling;
        const icon = btn.querySelector(".mobile-dropdown-icon");

        if (content && icon) {
          content.classList.toggle("hidden");
          icon.classList.toggle("rotate-180");
        }
      });
    });
  }

  // Close menu when clicking outside
  document.addEventListener("click", (e) => {
    if (
      mobileMenu &&
      mobileMenuBtn &&
      !mobileMenu.contains(e.target as Node) &&
      !mobileMenuBtn.contains(e.target as Node)
    ) {
      mobileMenu.classList.remove("scale-y-100");
      mobileMenu.classList.add("scale-y-0");
    }
  });
</script>
