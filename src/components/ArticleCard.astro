---
import type { ArticleItem } from "@/services/articles.service";
import { Picture } from "astro:assets";

interface Props {
  article: ArticleItem;
}

const { article } = Astro.props;

const imageUrl = article.thumbnailUrl;
const articleHref = `/article/${article.slug}`;
const alt = article.title;
const category = article.category;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Picture
      alt={alt}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      src={imageUrl}
      formats={["avif", "webp"]}
      loading={"eager"}
      fetchpriority={"high"}
      inferSize
    />
  </div>
  <div class="flex flex-grow flex-col p-6">
    <div class="mb-4">
      <span
        class="border-primary text-primary inline-block rounded border px-3 py-1 text-[10px] font-bold tracking-widest uppercase"
        >{category}</span
      >
    </div>
    <h3
      class="group-hover:text-primary mb-3 line-clamp-3 text-lg leading-snug font-bold text-slate-800 transition-colors dark:text-slate-100"
    >
      <a href={articleHref}>
        {article.title}
      </a>
    </h3>
  </div>
</article>
