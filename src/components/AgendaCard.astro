---
import { Image } from "astro:assets";
import { formatKeWIB } from "@/lib/dateFormateer";

import type { AgendaEvent } from "@/services/agenda.service";

interface Props {
  event: AgendaEvent;
}

const { event } = Astro.props;

const eventDate = new Date(event.date);
const now = new Date();
const isUpcoming = eventDate > now;
const isSameDay = eventDate.toDateString() === now.toDateString();

let statusConfig;

if (isUpcoming) {
  statusConfig = {
    label: "Akan Datang",
    icon: "event",
    color: "text-emerald-500",
    bg: "bg-emerald-50 dark:bg-emerald-900/10",
    border: "border-emerald-100 dark:border-emerald-900/30",
  };
} else if (isSameDay) {
  statusConfig = {
    label: "Sedang Berlangsung",
    icon: "play_circle",
    color: "text-blue-500",
    bg: "bg-blue-50 dark:bg-blue-900/10",
    border: "border-blue-100 dark:border-blue-900/30",
  };
} else {
  statusConfig = {
    label: "Telah Lewat",
    icon: "history",
    color: "text-slate-500",
    bg: "bg-slate-50 dark:bg-slate-900/10",
    border: "border-slate-100 dark:border-slate-900/30",
  };
}
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
>
  <a href={`/agenda/${event.slug}`} class="flex h-full flex-col">
    <div class="relative aspect-video overflow-hidden">
      {
        event.image ? (
          <Image
            alt={event.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            src={event.image}
            width={event.imageWidth!}
            height={event.imageHeight!}
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-slate-100 text-slate-400 dark:bg-slate-800">
            <span class="material-icons-outlined text-4xl">image</span>
          </div>
        )
      }
    </div>
    <div class="flex flex-grow flex-col p-5">
      <div class="mb-4 flex items-start gap-3">
        <div
          class={`flex-shrink-0 w-10 h-10 border ${statusConfig.border} rounded flex items-center justify-center ${statusConfig.color} ${statusConfig.bg}`}
        >
          <span class="material-icons-outlined text-[20px]">
            {statusConfig.icon}
          </span>
        </div>
        <div>
          <p
            class={`text-[13px] font-medium ${statusConfig.color} leading-tight`}
          >
            {statusConfig.label}
          </p>
          <p class="text-[13px] text-slate-500 dark:text-slate-400">
            {formatKeWIB(event.date)}
          </p>
        </div>
      </div>

      <h3
        class="text-lg leading-snug font-bold text-slate-800 transition-colors group-hover:text-teal-600 dark:text-slate-100"
      >
        {event.title}
      </h3>
    </div>
  </a>
</article>
