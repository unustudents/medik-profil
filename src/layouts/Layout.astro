---
import "@/styles/global.css";
import {
    SITE_TITLE,
    SITE_DESCRIPTION,
    ADDRESS,
    CONTACTS,
    OPENING_HOURS,
} from "@/consts";

interface Props {
    title?: string;
    description?: string;
    /** URL absolut gambar untuk OG/Twitter. Jika tidak diisi, tidak ada og:image. */
    image?: string;
    /** Tipe konten: "website" untuk halaman biasa, "article" untuk artikel/agenda */
    type?: "website" | "article";
    /** ISO date string — untuk article:published_time */
    publishedAt?: string;
    /** Nama penulis — untuk article:author */
    author?: string;
}

const {
    title = SITE_TITLE,
    description = SITE_DESCRIPTION,
    image,
    type = "website",
    publishedAt,
    author,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image
    ? new URL(image, Astro.site).toString()
    : undefined;

// JSON-LD: Hospital / Organization schema
const hospitalSchema = {
    "@context": "https://schema.org",
    "@type": "Hospital",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: Astro.site?.toString(),
    address: {
        "@type": "PostalAddress",
        streetAddress: ADDRESS,
        addressLocality: "Cilacap",
        addressRegion: "Jawa Tengah",
        addressCountry: "ID",
    },
    telephone: CONTACTS.phone,
    email: CONTACTS.email,
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
            ],
            opens: OPENING_HOURS.WEEKDAY.split(" - ")[0],
            closes: OPENING_HOURS.WEEKDAY.split(" - ")[1],
        },
    ],
    medicalSpecialty: ["Cardiology", "Pediatrics", "Otolaryngology"],
};
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Favicon -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- SEO: Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- SEO: Sitemap & RSS -->
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_TITLE} - RSS Feed`}
            href={new URL("rss.xml", Astro.site)}
        />

        <!-- SEO: Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta name="robots" content="index, follow" />

        <!-- SEO: Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="id_ID" />
        <meta property="og:site_name" content={SITE_TITLE} />
        {ogImageURL && <meta property="og:image" content={ogImageURL} />}
        {
            publishedAt && (
                <meta
                    property="article:published_time"
                    content={publishedAt}
                />
            )
        }
        {author && <meta property="article:author" content={author} />}

        <!-- SEO: Twitter Card -->
        <meta
            name="twitter:card"
            content={ogImageURL ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

        <!-- Fonts: Preconnect (Critical for performance) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Fonts: Non-render-blocking loading -->
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <link
            href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Outlined"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <!-- Fallback untuk browser tanpa JS -->
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
                rel="stylesheet"
            />
            <link
                href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Outlined"
                rel="stylesheet"
            />
            <link
                href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <!-- JSON-LD: Hospital Structured Data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(hospitalSchema)}
        />

        <!-- Theme: Prevent FOUC (Flash of Unstyled Content) -->
        <script is:inline>
            const theme = localStorage.getItem("theme");
            if (
                theme === "dark" ||
                (!theme &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body
        class="bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-100 transition-colors duration-200"
    >
        <slot />
    </body>
</html>
