---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactInfo from "@/components/ContactInfo.astro";
import { rooms } from "@/data/rooms";
---

<Layout
  title="Ketersediaan Kamar - RSU Afdila"
  description="Informasi ketersediaan kamar rawat inap RSU Afdila Cilacap secara real-time. Cek status kamar kosong dan terisi."
>
  <Header />
  <main class="min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div
        class="mb-12 flex flex-col items-start justify-between space-y-4 md:flex-row md:items-center md:space-y-0"
      >
        <div>
          <h1
            class="text-3xl font-bold tracking-tight text-black dark:text-white"
          >
            Ketersediaan Kamar
          </h1>
          <p class="mt-1 text-lg text-slate-600 dark:text-slate-400">
            RSU Afdila Premium Services
          </p>
        </div>
        <div
          class="flex items-center space-x-4 rounded-full bg-gray-50 p-2 px-4 shadow-sm dark:bg-gray-800"
        >
          <div class="flex items-center space-x-2">
            <span
              class="text-xs font-semibold tracking-wider text-gray-600 uppercase dark:text-gray-300"
              >Terisi</span
            >
            <div
              class="flex h-8 w-20 items-center justify-center rounded-full bg-[#545454] text-xs font-bold text-white uppercase"
            >
              Terisi
            </div>
          </div>
          <div class="h-4 w-px bg-gray-300 dark:bg-gray-600"></div>
          <div class="flex items-center space-x-2">
            <span
              class="text-xs font-semibold tracking-wider text-gray-600 uppercase dark:text-gray-300"
              >Kosong</span
            >
            <div
              class="bg-primary flex h-8 w-20 items-center justify-center rounded-full text-xs font-bold text-white uppercase shadow-sm"
            >
              Kosong
            </div>
          </div>
        </div>
      </div>
      <div class="space-y-8">
        {
          rooms.map((room) => (
            <div class="grid grid-cols-1 items-center gap-4 border-b border-gray-100 pb-6 md:grid-cols-12 dark:border-gray-800">
              <div class="md:col-span-4">
                <h2
                  class:list={[
                    "text-primary text-xl font-bold",
                    {
                      "text-sm tracking-wide uppercase":
                        room.name === "Neonatus Incubator",
                    },
                  ]}
                >
                  {room.name}
                </h2>
                <p class="mt-0.5 text-sm text-gray-500 italic dark:text-gray-400">
                  {room.description}
                </p>
              </div>
              <div class="flex flex-wrap gap-2 md:col-span-8">
                {room.beds.map((bed) => (
                  <div
                    class:list={[
                      "flex h-10 w-10 items-center justify-center rounded font-medium text-white",
                      bed.isOccupied ? "bg-[#545454]" : "bg-primary",
                    ]}
                  >
                    {bed.number}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <ContactInfo />
  <Footer />
</Layout>
