---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactInfo from "@/components/ContactInfo.astro";
---

<Layout title="404 - Halaman Tidak Ditemukan">
  <Header />
  <main
    class="flex min-h-[60vh] flex-col items-center justify-center bg-slate-50 px-4 py-20 text-center dark:bg-slate-900"
  >
    <h1
      class="mb-4 text-6xl font-bold text-teal-600/20 md:text-8xl dark:text-teal-400/20"
    >
      404
    </h1>
    <h2
      class="mb-4 text-2xl font-bold text-slate-800 md:text-3xl dark:text-slate-100"
    >
      Halaman Tidak Ditemukan
    </h2>
    <p class="mx-auto mb-8 max-w-md text-slate-600 dark:text-slate-400">
      Maaf, halaman yang Anda cari mungkin telah dihapus, dipindahkan, atau
      tidak tersedia.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-full bg-teal-600 px-6 py-3 font-medium text-white shadow-lg shadow-teal-600/20 transition-colors hover:bg-teal-700"
    >
      Kembali ke Beranda
    </a>
  </main>
  <ContactInfo />
  <Footer />
</Layout>
