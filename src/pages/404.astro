---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactInfo from "@/components/ContactInfo.astro";
---

<Layout title="404 - Halaman Tidak Ditemukan">
    <Header />
    <main class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-20 bg-slate-50 dark:bg-slate-900">
        <h1 class="text-6xl md:text-8xl font-bold text-teal-600/20 dark:text-teal-400/20 mb-4">404</h1>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-800 dark:text-slate-100 mb-4">Halaman Tidak Ditemukan</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">
            Maaf, halaman yang Anda cari mungkin telah dihapus, dipindahkan, atau tidak tersedia.
        </p>
        <a href="/" class="inline-flex items-center justify-center bg-teal-600 hover:bg-teal-700 text-white px-6 py-3 rounded-full font-medium transition-colors shadow-lg shadow-teal-600/20">
            Kembali ke Beranda
        </a>
    </main>
    <ContactInfo />
    <Footer />
</Layout>
