---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactInfo from "@/components/ContactInfo.astro";
import { getAgendaEvents } from "@/services/agenda.service";
import AgendaCard from "@/components/AgendaCard.astro";
import Pagination from "@/components/Pagination.astro";
import { AGENDA_EVENTS_PAGINATE } from "@/consts";

// Get page param
const pageParam = Astro.params.page;
const currentPage = pageParam ? parseInt(pageParam, 10) : 1;

// Redirect invalid or page 1 to home
if (!currentPage || isNaN(currentPage) || currentPage <= 1) {
  return Astro.redirect("/agenda");
}

// Fetch dari Strapi API
const { data: agendaList, pagination } = await getAgendaEvents({
  page: currentPage,
  pageSize: AGENDA_EVENTS_PAGINATE,
});

// If page out of range
if (agendaList.length === 0 && currentPage > 1) {
  return Astro.redirect("/404");
}

const baseUrl = "/agenda/page";
const homeUrl = "/agenda";

// Build page object
const page = {
  data: agendaList,
  start: (pagination.page - 1) * pagination.pageSize,
  end: (pagination.page - 1) * pagination.pageSize + agendaList.length - 1,
  currentPage: pagination.page,
  lastPage: pagination.pageCount,
  total: pagination.total,
  size: pagination.pageSize,
  url: {
    current: `${baseUrl}/${currentPage}`,
    prev:
      currentPage > 1
        ? currentPage === 2
          ? homeUrl
          : `${baseUrl}/${currentPage - 1}`
        : undefined,
    next:
      currentPage < pagination.pageCount
        ? `${baseUrl}/${currentPage + 1}`
        : undefined,
    first: homeUrl,
    last:
      currentPage < pagination.pageCount
        ? `${baseUrl}/${pagination.pageCount}`
        : undefined,
  },
};
---

<Layout
  title={`Agenda Kegiatan - Halaman ${page.currentPage} - RSU Afdila`}
  description="Jadwal agenda dan kegiatan kesehatan RSU Afdila Cilacap."
>
  <Header />

  <main
    class="bg-slate-50 py-12 transition-colors duration-200 md:py-16 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1
        class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl dark:text-white"
      >
        Agenda Kegiatan
      </h1>
      <p class="max-w-2xl text-slate-500 dark:text-slate-400">
        Ikuti berbagai agenda dan kegiatan kesehatan menarik yang
        diselenggarakan oleh RSU Afdila untuk masyarakat.
      </p>
    </div>
  </main>

  <main
    class="mx-auto max-w-7xl bg-slate-50 px-4 pb-20 transition-colors duration-200 sm:px-6 lg:px-8 dark:bg-slate-900"
  >
    {
      agendaList.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {agendaList.map((event: any) => (
            <AgendaCard event={event} />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center text-slate-500 dark:text-slate-400">
          <span class="material-icons-outlined mb-4 block text-6xl">
            event_busy
          </span>
          <p class="text-xl font-medium">Belum ada agenda tersedia.</p>
        </div>
      )
    }

    <Pagination page={page} baseUrl={baseUrl} firstPageUrl={homeUrl} />
  </main>

  <ContactInfo />
  <Footer />
</Layout>
