---
import Layout from "@/layouts/Layout.astro";
import { Header, Footer, ContactInfo, FormattedDate } from "@/components/index";
import StrapiBlockRenderer from "@/components/strapi_block/StrapiBlockRenderer.astro";
import {
  getAllCategories,
  getArticleBySlug,
  getRelatedArticles,
} from "@/services/articles.service";
import type { StrapiBlockField } from "@/services/articles.service";
import { Picture } from "astro:assets";

// slug dari URL: /article/judul-artikel
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// Fetch artikel by slug
const article = await getArticleBySlug(slug);
if (!article) {
  return Astro.redirect("/404");
}
// Fetch semua kategori untuk sidebar
const category = await getAllCategories();
// Fetch artikel terkait berdasarkan kategori
const relatedArticles = await getRelatedArticles(
  article.category,
  article.documentId,
  3
);
---

<Layout
  title={`${article.title} - RSU Afdila`}
  description={`${article.title} - Artikel kesehatan RSU Afdila Cilacap. Baca selengkapnya tentang ${article.category.toLowerCase()}.`}
  image={article.thumbnailUrl}
  type="article"
  publishedAt={new Date(article.date).toISOString()}
>
  <Header />
  <main
    class="bg-background-light dark:bg-background-dark font-display text-[#111717] transition-colors duration-200 dark:text-white"
  >
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav
        class="mb-8 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400"
      >
        <a class="hover:text-primary" href="/">Beranda</a>
        <span class="material-icons-outlined text-xs">chevron_right</span>
        <a class="hover:text-primary" href="/article">Artikel</a>
        <span class="material-icons-outlined text-xs">chevron_right</span>
        <span class="text-primary font-medium">Detail Artikel</span>
      </nav>
      <!-- Hero Section -->
      <div
        class="group relative mb-10 aspect-[21/9] w-full overflow-hidden rounded-2xl"
      >
        <Picture
          alt={article.title}
          class="h-full w-full object-cover"
          src={article.thumbnailUrl}
          formats={["avif", "webp"]}
          loading={"eager"}
          fetchpriority={"high"}
          inferSize
        />
        <div
          class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/20 to-transparent p-8 md:p-12"
        >
          <div class="max-w-4xl">
            <span
              class="bg-primary mb-4 inline-block rounded px-3 py-1 text-xs font-bold tracking-wider text-white uppercase"
              >{article.category}</span
            >
            <h1
              class="mb-4 text-3xl leading-tight font-bold text-white md:text-5xl"
            >
              {article.title}
            </h1>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Article Body -->
        <article class="lg:col-span-8">
          <!-- Metadata -->
          <div
            class="mb-8 flex flex-wrap items-center gap-6 border-b border-gray-100 pb-8 text-sm text-gray-600 dark:border-gray-800 dark:text-gray-400"
          >
            <div class="flex items-center gap-2">
              <span class="material-icons-outlined text-primary"
                >calendar_month</span
              >
              <span><FormattedDate date={new Date(article.date)} /></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-icons-outlined text-primary">category</span>
              <span>{article.category}</span>
            </div>
          </div>
          <!-- Content -->
          <div class="article-content">
            <StrapiBlockRenderer
              content={article.content as StrapiBlockField}
            />
          </div>

          <!-- Footer Article / Tags & Share -->
          <div
            class="mt-12 flex flex-col justify-between gap-6 border-t border-gray-100 pt-8 md:flex-row md:items-center dark:border-gray-800"
          >
            <div class="flex flex-wrap gap-2">
              <span
                class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-600 dark:bg-gray-800 dark:text-gray-400"
              >
                {article.category}
              </span>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-sm font-medium text-gray-500">Bagikan:</span>
              <div class="flex gap-2">
                <a
                  class="bg-primary/10 hover:bg-primary text-primary flex size-10 items-center justify-center rounded-full transition-all hover:text-white"
                  href="#"
                >
                  <!-- Facebook Icon -->
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path
                      d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7h-2.54v-2.9h2.54V9.82c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02z"
                    ></path>
                  </svg>
                </a>
                <a
                  class="bg-primary/10 hover:bg-primary text-primary flex size-10 items-center justify-center rounded-full transition-all hover:text-white"
                  href="#"
                >
                  <!-- Twitter/X Icon -->
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
                    ></path>
                  </svg>
                </a>
                <a
                  class="bg-primary/10 hover:bg-primary text-primary flex size-10 items-center justify-center rounded-full transition-all hover:text-white"
                  href="#"
                >
                  <!-- LinkedIn/Link Icon -->
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <!-- CTA Banner -->
          <div
            class="mt-12 flex flex-col items-center gap-8 rounded-2xl border border-white/10 bg-slate-900 p-8 text-white md:flex-row dark:bg-black/20"
          >
            <div class="flex-1">
              <h3 class="mb-2 text-2xl font-bold">Punya keluhan kesehatan?</h3>
              <p class="text-white/80">
                Konsultasikan langsung dengan dokter spesialis jantung kami di
                RSU Afdila. Kami siap melayani Anda 24/7.
              </p>
            </div>
            <button
              class="bg-primary rounded-xl px-8 py-3 font-bold whitespace-nowrap text-white transition-transform hover:scale-105"
            >
              Konsultasi Sekarang
            </button>
          </div>
        </article>
        <!-- Sidebar -->
        <aside class="space-y-8 lg:col-span-4">
          <!-- Related Articles -->
          <div
            class="rounded-2xl border border-gray-100 bg-white p-6 dark:border-gray-800 dark:bg-slate-900"
          >
            <h3
              class="mb-6 flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white"
            >
              <span class="material-icons-outlined text-primary">article</span>
              Artikel Terkait
            </h3>
            <div class="space-y-6">
              {
                relatedArticles.map((related) => (
                  <a class="group flex gap-4" href={`/article/${related.slug}`}>
                    <div class="size-20 flex-shrink-0 overflow-hidden rounded-lg">
                      <img
                        class="h-full w-full object-cover transition-transform group-hover:scale-110"
                        src={related.thumbnailUrl}
                        alt={related.title}
                      />
                    </div>
                    <div class="flex flex-col justify-center">
                      <h4 class="group-hover:text-primary line-clamp-2 text-sm font-bold text-slate-800 transition-colors dark:text-gray-200">
                        {related.title}
                      </h4>
                      <span class="mt-1 text-xs text-gray-500">
                        <FormattedDate date={new Date(related.date)} />
                      </span>
                    </div>
                  </a>
                ))
              }
            </div>
            <a
              href="/article"
              class="text-primary border-primary/20 hover:bg-primary/5 mt-8 block w-full rounded-xl border py-3 text-center text-sm font-bold transition-colors"
            >
              Lihat Semua Artikel
            </a>
          </div>
          <!-- Newsletter / Subscribe -->
          <div
            class="bg-primary/10 dark:bg-primary/5 border-primary/10 rounded-2xl border p-6"
          >
            <h3 class="mb-2 text-lg font-bold text-slate-900 dark:text-white">
              Update Kesehatan
            </h3>
            <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
              Dapatkan tips kesehatan mingguan langsung ke inbox Anda.
            </p>
            <div class="space-y-3">
              <input
                class="focus:ring-primary focus:border-primary w-full rounded-xl border-gray-200 bg-white p-3 text-sm dark:border-gray-700 dark:bg-slate-800"
                placeholder="Email Anda"
                type="email"
              />
              <button
                class="bg-primary shadow-primary/20 w-full rounded-xl py-3 text-sm font-bold text-white shadow-lg"
                >Berlangganan</button
              >
            </div>
          </div>
          <!-- Doctor Highlight -->
          <div
            class="rounded-2xl border border-gray-100 bg-white p-6 dark:border-gray-800 dark:bg-slate-900"
          >
            <h3
              class="mb-4 text-sm font-bold tracking-widest text-gray-400 uppercase"
            >
              Kategori
            </h3>
            <div class="flex items-center gap-4">
              <div>
                <h4 class="text-[#111717] dark:text-white">
                  {
                    category.map((data) => (
                      <a
                        href={`/article/category/${data.name.toLowerCase()}`}
                        class="hover:text-primary block py-1 transition-colors"
                      >
                        {data.name}
                      </a>
                    ))
                  }
                </h4>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <ContactInfo />
  <Footer />
</Layout>
