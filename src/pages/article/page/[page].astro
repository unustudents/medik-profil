---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ContactInfo from "@/components/ContactInfo.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";
import { ARTICLES_PAGINATE } from "@/consts";
import { getArticles } from "@/services/articles.service";

// Get page param
const pageParam = Astro.params.page;
const currentPage = pageParam ? parseInt(pageParam, 10) : 1;

// Redirect invalid or page 1 to home
if (!currentPage || isNaN(currentPage) || currentPage <= 1) {
  return Astro.redirect("/article");
}

// Fetch Strapi
const { data: articleList, pagination } = await getArticles({
  page: currentPage,
  pageSize: ARTICLES_PAGINATE,
});

// If page out of range
if (articleList.length === 0 && currentPage > 1) {
  return Astro.redirect("/404");
}

const baseUrl = "/article/page";
const homeUrl = "/article";

// Build page object
const page = {
  data: articleList,
  start: (pagination.page - 1) * pagination.pageSize,
  end: (pagination.page - 1) * pagination.pageSize + articleList.length - 1,
  currentPage: pagination.page,
  lastPage: pagination.pageCount,
  total: pagination.total,
  size: pagination.pageSize,
  url: {
    current: `${baseUrl}/${currentPage}`,
    prev:
      currentPage > 1
        ? currentPage === 2
          ? homeUrl
          : `${baseUrl}/${currentPage - 1}`
        : undefined,
    next:
      currentPage < pagination.pageCount
        ? `${baseUrl}/${currentPage + 1}`
        : undefined,
    first: homeUrl,
    last:
      currentPage < pagination.pageCount
        ? `${baseUrl}/${pagination.pageCount}`
        : undefined,
  },
};
---

<Layout
  title={`Informasi & Edukasi Kesehatan - Halaman ${page.currentPage} - RSU Afdila`}
  description="Artikel kesehatan terpercaya dan berita terbaru seputar layanan RSU Afdila Cilacap. Tips kesehatan, edukasi medis, dan informasi rumah sakit."
>
  <Header />
  <main class="min-h-screen px-4 py-16 md:px-8">
    <div class="mx-auto max-w-7xl">
      <header class="mb-12">
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl dark:text-white"
        >
          Informasi & Edukasi Kesehatan
        </h1>
        <p class="max-w-2xl text-lg text-slate-600 dark:text-slate-400">
          Dapatkan artikel kesehatan terpercaya dan berita terbaru seputar
          layanan RSU Afdila.
        </p>
      </header>

      {
        articleList.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {articleList.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="py-20 text-center text-slate-500 dark:text-slate-400">
            <span class="material-icons-outlined mb-4 block text-6xl">
              article
            </span>
            <p class="text-xl font-medium">Belum ada artikel tersedia.</p>
          </div>
        )
      }

      <Pagination page={page} baseUrl={baseUrl} firstPageUrl={homeUrl} />
    </div>
  </main>
  <ContactInfo />
  <Footer />
</Layout>
