---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { Header, Footer, ContactInfo } from "@/components";
import { getPaymentMethods } from "@/services/payment.service";
import { BATCH_SIZE } from "@/consts";

const paymentMethods = await getPaymentMethods();
const hasMore = paymentMethods.length > BATCH_SIZE;
---

<Layout
  title="Metode Pembayaran - RSU Afdila"
  description="Berbagai metode pembayaran yang diterima di RSU Afdila Cilacap. Tunai, kartu kredit, debit, dan pembayaran digital."
>
  <Header />

  <main
    class="min-h-screen bg-slate-50 transition-colors duration-300 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="mb-10">
        <h1 class="mb-2 text-3xl font-bold text-slate-900 dark:text-white">
          Metode Pembayaran
        </h1>
        <p class="text-lg text-slate-500 dark:text-slate-400">
          Pilih metode pembayaran yang Anda inginkan
        </p>
      </div>

      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
        id="payment-grid"
      >
        {
          paymentMethods.map((method, index) => (
            <div
              class={`group payment-card-shadow payment-item relative h-32 overflow-hidden rounded-2xl border-2 border-slate-100 bg-white transition-all duration-200 hover:border-teal-500/50 hover:shadow-lg ${index >= BATCH_SIZE ? "hidden translate-y-4 opacity-0" : "translate-y-0 opacity-100"} flex items-center justify-center p-4`}
              title={method.name}
            >
              <Picture
                src={method.image}
                alt={method.alt}
                format={"avif"}
                fit={"cover"}
                inferSize
                class="h-auto max-h-full w-auto max-w-full object-contain transition-transform duration-300 group-hover:scale-110"
                loading={index >= BATCH_SIZE ? "lazy" : "eager"}
                decoding={index >= BATCH_SIZE ? "async" : "auto"}
              />
            </div>
          ))
        }
      </div>

      {
        hasMore && (
          <div class="mt-12 text-center" id="load-more-container">
            <button
              id="load-more-btn"
              class="cursor-pointer rounded-full border border-slate-200 bg-white px-8 py-3 font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              Lebih Banyak
            </button>
          </div>
        )
      }
    </div>
  </main>

  <ContactInfo />
  <Footer />
</Layout>

<style>
  .payment-card-shadow {
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 2px 4px -1px rgba(0, 0, 0, 0.03);
  }
</style>

<script is:inline define:vars={{ BATCH_SIZE, hasMore }}>
  if (hasMore) {
    function updateButtonVisibility() {
      const paymentGrid = document.getElementById("payment-grid");
      const loadMoreContainer = document.getElementById("load-more-container");

      // Cari semua item yang masih punya class 'hidden'
      const hiddenItems = paymentGrid
        ? paymentGrid.querySelectorAll(".payment-item.hidden")
        : [];

      // Jika tidak ada lagi yang tersembunyi, hapus tombolnya
      if (hiddenItems.length === 0 && loadMoreContainer) {
        loadMoreContainer.style.display = "none";
      }
    }

    // Jalankan pengecekan setiap kali tombol di-klik
    const loadMoreBtn = document.getElementById("load-more-btn");
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        const paymentGrid = document.getElementById("payment-grid");
        const hiddenItems = paymentGrid
          ? paymentGrid.querySelectorAll(".payment-item.hidden")
          : [];
        const itemsToShow = Array.from(hiddenItems).slice(0, BATCH_SIZE);

        itemsToShow.forEach((item, index) => {
          item.classList.remove("hidden");
          setTimeout(() => {
            item.classList.remove("opacity-0", "translate-y-4");
            item.classList.add("opacity-100", "translate-y-0");
          }, index * 50);
        });

        // Tunggu animasi selesai sedikit, lalu cek apakah tombol harus hilang
        setTimeout(updateButtonVisibility, itemsToShow.length * 50 + 100);
      });
    }
  }
</script>
