---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ContactInfo from "@/components/ContactInfo.astro";
import Footer from "@/components/Footer.astro";
// Data dokter hari ini (bisa diganti dengan data dari API/database)
import { todayDoctors } from "@/data/dokter-jaga";

// Number of doctors to show initially
const initialCount = 4;
---

<Layout
  title="Dokter Hari Ini - RSU Afdila"
  description="Daftar dokter yang bertugas dan praktik hari ini di RSU Afdila Cilacap. Informasi jadwal dan lokasi praktik."
>
  <Header />
  <main>
    <div class="container mx-auto max-w-5xl px-4 py-12">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">
          Dokter Hari Ini
        </h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">
          Daftar dokter yang praktik hari ini
        </p>
      </div>

      <div class="space-y-6" id="doctor-list">
        {
          todayDoctors.map((doctor, index) => (
            <div
              class={`doctor-item border-primary flex flex-col items-center overflow-hidden rounded-lg border-t-2 bg-white p-6 shadow-sm transition-all duration-500 hover:shadow-md md:flex-row dark:bg-gray-800 ${index >= initialCount ? "hidden translate-y-4 opacity-0" : "translate-y-0 opacity-100"}`}
            >
              <div class="mb-4 flex-shrink-0 md:mb-0">
                <img
                  alt={doctor.name}
                  class="border-primary/10 h-32 w-32 rounded-xl border-2 object-cover md:h-40 md:w-40"
                  src={doctor.image}
                  loading={index >= initialCount ? "lazy" : "eager"}
                  decoding={index >= initialCount ? "async" : "auto"}
                />
              </div>
              <div class="flex-grow text-center md:ml-8 md:text-left">
                <h2 class="text-primary mb-3 text-xl font-bold">
                  {doctor.name}
                </h2>
                <ul class="space-y-1.5 text-sm text-gray-600 dark:text-gray-300">
                  {doctor.details.map((detail) => (
                    <li class="flex items-center justify-center md:justify-start">
                      <span class="material-icons-outlined text-primary mr-2 text-lg">
                        {detail.icon}
                      </span>
                      {detail.label}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mt-6 flex w-full flex-col items-center justify-center border-gray-100 text-center md:mt-0 md:ml-8 md:w-auto md:items-end md:border-l md:pl-8 md:text-right dark:border-gray-700">
                <div class="mb-4">
                  <p class="text-lg font-semibold text-gray-800 dark:text-gray-100">
                    {doctor.schedule}
                  </p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">
                    {doctor.location}
                  </p>
                  {doctor.ext && (
                    <p class="mt-1 text-xs tracking-wider text-gray-400 uppercase">
                      Ext : {doctor.ext}
                    </p>
                  )}
                </div>
                <button class="bg-primary hover:bg-opacity-90 rounded-full px-6 py-2 font-medium text-white shadow-sm transition-all active:scale-95">
                  Cek Profil
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-12 text-center" id="load-more-container">
        <button
          id="load-more-btn"
          class="cursor-pointer rounded-full border border-slate-200 bg-white px-8 py-3 font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          Lihat Semua Dokter
        </button>
      </div>
    </div>
    <ContactInfo />
  </main>
  <Footer />
</Layout>

<style>
  /* FIX: Force display none when hidden class is present */
  .doctor-item.hidden {
    display: none !important;
  }
</style>

<script>
  const loadMoreBtn = document.getElementById("load-more-btn");
  const loadMoreContainer = document.getElementById("load-more-container");
  const BATCH_SIZE = 4; // Load 4 doctors per click

  // Function to check and hide button when no more items
  function updateButtonVisibility() {
    const hiddenItems = document.querySelectorAll(".doctor-item.hidden");

    if (hiddenItems.length === 0 && loadMoreContainer) {
      loadMoreContainer.style.display = "none";
    }
  }

  // Check initial state
  updateButtonVisibility();

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener("click", () => {
      const hiddenItems = document.querySelectorAll(".doctor-item.hidden");

      // Only show next batch (BATCH_SIZE items)
      const itemsToShow = Array.from(hiddenItems).slice(0, BATCH_SIZE);

      itemsToShow.forEach((item, index) => {
        // Remove hidden class
        item.classList.remove("hidden");

        // Add staggered animation
        setTimeout(() => {
          item.classList.remove("opacity-0", "translate-y-4");
          item.classList.add("opacity-100", "translate-y-0");
        }, index * 50);
      });

      // Update button text after loading batch
      setTimeout(
        () => {
          updateButtonVisibility();
        },
        itemsToShow.length * 50 + 100
      );
    });
  }
</script>
